---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      {% assign groups = page.profiles | map: 'group' | uniq %}
      {% for group in groups %}
        <h2 class="people-group">{{ group }}</h2>
        <div class="people-grid people-grid-{{ group | slugify }}">
          {% for profile in page.profiles %}
            {% if profile.group == group %}
              <div class="person-card">
                {% if profile.image %}
                  {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
                  {% include figure.liquid loading="eager" path=profile_image_path class="person-photo" alt=profile.name %}
                {% endif %}
                <h5 class="person-name">{{ profile.name }}</h5>
                <div class="person-desc">{{ profile.description | markdownify }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
  </article>
</div>
